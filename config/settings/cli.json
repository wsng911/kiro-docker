{
  "chat.defaultModel": "claude-sonnet-4",
  "chat.defaultAgent": "kiro_default",
  "chat.enableThinking": false,
  "chat.enableKnowledge": true,
  "chat.enableCodeIntelligence": true,
  "chat.enableSubagent": true,
  "chat.enableTodoList": true,
  "chat.enableNotifications": false,
  "chat.greeting.enabled": false,
  "chat.disableAutoCompaction": false,
  "chat.autoExpandToolOutput": false,
  "telemetry.enabled": false,
  "knowledge.indexType": "fast",
  "knowledge.maxFiles": 10000,
  "knowledge.chunkSize": 512,
  "knowledge.chunkOverlap": 128,
  "knowledge.defaultIncludePatterns": ["**/*.md", "**/*.ts", "**/*.py"],
  "knowledge.defaultExcludePatterns": ["node_modules/**", ".git/**", "target/**"],
  "api.timeout": 60000,
  "mcp.initTimeout": 30000,
  "mcp.noInteractiveTimeout": 10000,
  "compaction.excludeContextWindowPercent": 10,
  "compaction.excludeMessages": 2
}
